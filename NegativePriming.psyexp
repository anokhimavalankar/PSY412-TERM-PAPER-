    <Routine name="Instructions"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'condition': 1, 'primeTarget': 'A', 'primeDistractor': 'B', 'probe': 'B', 'corrAns': 'J'}, {'condition': 2, 'primeTarget': 'A', 'primeDistractor': 'B', 'probe': 'C', 'corrAns': 'F'}, {'condition': 3, 'primeTarget': 'A', 'primeDistractor': 'B', 'probe': 'D', 'corrAns': 'J'}, {'condition': 4, 'primeTarget': 'B', 'primeDistractor': 'A', 'probe': 'A', 'corrAns': 'F'}, {'condition': 5, 'primeTarget': 'B', 'primeDistractor': 'A', 'probe': 'C', 'corrAns': 'F'}, {'condition': 6, 'primeTarget': 'B', 'primeDistractor': 'A', 'probe': 'D', 'corrAns': 'J'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditionssolo1.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="10" valType="code"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="trials"/>
    <Routine name="End"/>
  </Flow>
</PsychoPy2experiment>
